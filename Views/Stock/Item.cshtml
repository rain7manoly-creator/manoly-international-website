@model ManolyWarehouse.Application.Services.StockItemDetailViewModel
@{
    var s = Model.Item;
    ViewData["Title"] = s.DisplayName;
    var isAdmin = User.IsInRole("Admin");
    var famName = ManolyWarehouse.Application.Services.StockService.FamilyNames.GetValueOrDefault(s.Family, s.Family);
    var hasWarehouse = s.Family is "metro" or "sh";
    string F(int? v) => v.HasValue ? v.Value.ToString("N0") : "—";
}

<div class="px-4 pt-5 pb-3">
    <a href="/stock" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        المخزون · @famName
    </a>
    <h1 class="page-title">@s.Name</h1>
    @if (!string.IsNullOrEmpty(s.ColorLabel))
    {
        <p class="text-sm text-bark mt-1">@s.ColorLabel</p>
    }
</div>

@* ── The number ─────────────────────────────────────────── *@
<div class="mx-4 card p-5 mb-4 flex items-end justify-between gap-4">
    <div>
        <div class="text-xs text-bark-l mb-1">المجموع</div>
        <div class="history-qty" style="font-size:40px; line-height:1; @(s.Total <= 0 ? "color:#CA292E" : "")" dir="ltr">
            @(s.QtyText ?? F(s.Total))
        </div>
    </div>
    <div class="text-xs text-bark-l text-left">
        آخر تغيير<br /><span dir="ltr">@s.UpdatedAt.ToLocalString()</span>
    </div>
</div>

@* ── Where it is: warehouse shelves and Area Z, for ordering ─── *@
@if (Model.Shelves.Any() || Model.AreaZ.Any())
{
    <div class="mx-4 card mb-4">
        <div class="px-4 py-3 text-sm font-semibold flex justify-between" style="border-bottom:1px solid #E3E4E5">
            <span>أين المخزون</span><span class="text-xs text-bark-l">@s.UnitLabel</span>
        </div>
        <div class="px-4 py-3 flex gap-6 flex-wrap" style="border-bottom:1px solid #E3E4E5">
            <div><div class="text-xs text-bark-l">المستودع (الرفوف)</div><div class="history-qty">@Model.Shelves.Sum(x => x.Qty).ToString("N0")</div></div>
            @foreach (var z in Model.AreaZ)
            {
                <div><div class="text-xs text-bark-l">Area Z · @z.Name</div><div class="history-qty" style="color:#9A6200">@z.Qty.ToString("N0")</div></div>
            }
        </div>
        @foreach (var sh in Model.Shelves)
        {
            <div class="px-4 py-2 flex justify-between text-sm" style="border-top:1px solid #F1F1F2"><span dir="ltr">@sh.Name</span><b>@sh.Qty.ToString("N0")</b></div>
        }
    </div>
}

@* ── Linked shelf products ─────────────────────────────── *@
<div class="mx-4 card mb-4">
    <div class="px-4 py-3 text-sm font-semibold flex items-center justify-between gap-2" style="border-bottom:1px solid #E3E4E5">
        <span>مرتبط بمنتجات على الرفوف</span>
        @if (isAdmin && s.QtyText == null)
        {
            <a href="/stock/items/@s.Id/link" class="btn-secondary btn-sm">+ ربط منتج</a>
        }
    </div>
    @if (Model.LinkedProducts.Any())
    {
        foreach (var p in Model.LinkedProducts)
        {
            <div class="list-item justify-between gap-2">
                <a href="/products/@p.Id" class="text-sm min-w-0" style="color:#2F7A4A">● @p.Name</a>
                @if (isAdmin)
                {
                    <form method="post" action="/stock/items/@s.Id/unlink" class="shrink-0" id="unlink-@p.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="button" class="btn-ghost btn-sm"
                                onclick="confirmSubmit('إلغاء الربط', 'لن تتغير الأرقام، لكن تغييرات هذا المنتج على الرفوف لن تصل لهذا الصنف بعد الآن.', 'unlink-@p.Id', 'إلغاء الربط')">إلغاء</button>
                    </form>
                }
            </div>
        }
        <p class="px-4 pb-3 text-xs text-bark-l">أي تغيير على كمية هذه المنتجات في الرفوف أو Area Z ينزل أو يزيد هنا تلقائياً (@s.UnitLabel).</p>
    }
    else
    {
        <p class="px-4 py-3 text-sm text-bark">غير مرتبط بعد. اضغط «+ ربط منتج» واختر المنتج من الرفوف.</p>
    }
</div>

@if (isAdmin && ManolyWarehouse.Domain.Entities.StockGroupRegistry.IsCustom(s.Family))
{
    <div class="mx-4 card p-4 mb-4 flex flex-col gap-2">
        <div class="text-sm font-semibold flex justify-between"><span>اسم السطر</span><a href="/stock/groups/@s.Family" class="text-xs" style="color:#CA292E">إدارة @famName</a></div>
        <form method="post" action="/stock/items/@s.Id/rename" class="flex gap-2">
            @Html.AntiForgeryToken()
            <input type="text" name="name" value="@s.Name" class="form-input flex-1" required maxlength="200" aria-label="اسم السطر" />
            <button type="submit" class="btn-primary btn-sm shrink-0">حفظ</button>
        </form>
    </div>
}

@* ── Warning number ────────────────────────────────────── *@
@if (isAdmin && s.QtyText == null)
{
    <div class="mx-4 card p-4 mb-4">
        <div class="text-sm font-semibold mb-2">التنبيه</div>
        <partial name="_AlertForm" model='("line", s.Id, s.AlertAt, s.UnitLabel, $"/stock/items/{s.Id}")' />
    </div>
}

@* ── Admin correction ──────────────────────────────────── *@
@if (isAdmin && s.QtyText == null)
{
    <div class="mx-4 card p-5 mb-5">
        <p class="eyebrow mb-3">EDIT · تعديل يدوي</p>
        <form method="post" action="/stock/items/@s.Id" class="flex flex-col gap-4" id="stock-form">
            @Html.AntiForgeryToken()
            @if (hasWarehouse)
            {
                @* The warehouse number comes from the shelves + Area Z, so it isn't typed here *@
                <input type="hidden" name="warehouse" value="@s.Warehouse" />
                <div class="form-group">
                    <label class="form-label" for="shops">محلات</label>
                    <input type="number" id="shops" name="shops" value="@s.Shops" class="form-input" inputmode="numeric" data-feeds-total />
                </div>
                <div class="form-group">
                    <label class="form-label" for="ordered">للطلب</label>
                    <input type="number" id="ordered" name="ordered" min="0" value="@s.Ordered" class="form-input" inputmode="numeric" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="onWay">بالطريق</label>
                    <input type="number" id="onWay" name="onWay" min="0" value="@s.OnWay" class="form-input" inputmode="numeric" />
                </div>
            }
            @if (s.Family == "smirdex")
            {
                <div class="form-group">
                    <label class="form-label" for="ordered">الطلب</label>
                    <input type="number" id="ordered" name="ordered" min="0" value="@s.Ordered" class="form-input" inputmode="numeric" />
                </div>
            }
            <div class="form-group">
                <label class="form-label" for="total">@(s.Family == "smirdex" ? "العدد بالكرتونة" : "المجموع")</label>
                <input type="number" id="total" name="total" value="@s.Total" class="form-input" inputmode="numeric" />
            </div>
            <div class="form-group">
                <label class="form-label" for="note">ملاحظة (اختيارية)</label>
                <input type="text" id="note" name="note" maxlength="200" class="form-input" placeholder="مثلاً: وصلت الطلبية، جرد…" />
            </div>
            <button type="submit" class="btn-primary w-full">حفظ</button>
        </form>
    </div>
}

@* ── History ───────────────────────────────────────────── *@
<div class="px-4 mb-2 flex items-end justify-between">
    <div>
        <p class="eyebrow mb-1">HISTORY · السجل</p>
        <h2 class="section-title">حركة المخزون</h2>
    </div>
    <span class="text-xs text-bark-l">@Model.Movements.Count حركة</span>
</div>
@if (!Model.Movements.Any())
{
    <p class="mx-4 mb-6 text-sm text-bark-l">لا توجد حركة منذ تحميل الأرقام من ملف Excel.</p>
}
else
{
    <ol class="mx-4 card mb-6 history-list">
        @foreach (var m in Model.Movements)
        {
            <li class="history-row">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="history-from">@F(m.TotalBefore)</span>
                    <svg class="w-3.5 h-3.5 text-bark-l shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    <span class="history-to">@F(m.TotalAfter)</span>
                    @if (m.Delta is int d && d != 0)
                    {
                        <span class="delta-chip @(d > 0 ? "delta-up" : "delta-down")" dir="ltr">@(d > 0 ? "+" : "")@d.ToString("N0")</span>
                    }
                </div>
                <div class="history-note">@m.Reason</div>
                <div class="text-xs text-bark-l mt-1">@(m.UserName ?? "—") · <span dir="ltr">@m.CreatedAt.ToLocalString()</span></div>
            </li>
        }
    </ol>
}

@section Scripts {
<script>
// Changing the warehouse or shops number moves the total by the same amount (it can still be typed directly)
(function () {
    const total = document.getElementById('total');
    if (!total) return;
    document.querySelectorAll('[data-feeds-total]').forEach(inp => {
        let last = parseInt(inp.value, 10) || 0;
        inp.addEventListener('input', () => {
            const now = parseInt(inp.value, 10) || 0;
            if (total.value !== '') total.value = (parseInt(total.value, 10) || 0) + (now - last);
            last = now;
        });
    });
})();
</script>
}
