@model ManolyWarehouse.Application.Services.ConnectViewModel
@{
    ViewData["Title"] = "ربط بالمخزون";
    var back = (string)ViewBag.Back;
    string Fam(string f) => ManolyWarehouse.Application.Services.StockService.FamilyNames.GetValueOrDefault(f, f);
    string Col(string? c) => c == "white" ? " — أبيض" : c == "grey" ? " — سكني" : "";
    var preselect = Model.CurrentId ?? Model.SuggestedId;
    // Same family as the product first, so the right line is near the top
    var groups = Model.Lines.GroupBy(l => l.Family)
        .OrderBy(g => g.Key == Model.GuessFamily ? 0 : 1).ThenBy(g => g.First().Id).ToList();
}

<div class="px-4 pt-5 pb-3">
    <a href="@back" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        رجوع
    </a>
    <p class="eyebrow mb-1">CONNECT · ربط بالمخزون</p>
    <h1 class="page-title">@Model.ProductName</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Where))
    {
        <p class="text-sm text-bark mt-1" dir="ltr" style="text-align:right">@Model.Where</p>
    }
</div>

<form method="post" action="/stock/check/connect" class="px-4 pb-8 flex flex-col gap-3" id="connect-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" value="@Model.ProductId" />
    <input type="hidden" name="back" value="@back" />

    @if (Model.SuggestedId is int sug && Model.CurrentId is null)
    {
        var s = Model.Lines.First(l => l.Id == sug);
        <div class="card p-4" style="border-color:#2F7A4A">
            <div class="text-xs text-bark-l mb-1">الأقرب حسب الاسم</div>
            <div class="font-semibold text-ink mb-3">@s.Name@Col(s.Color)</div>
            <button type="submit" name="target" value="line:@sug" class="btn-primary w-full">ربط بهذا الصنف</button>
        </div>
        <p class="text-xs text-bark-l text-center">أو اختر صنفاً آخر:</p>
    }

    <input type="text" id="line-filter" class="form-input" placeholder="ابحث: سلم 12 550، 4x30، 4268…" autocomplete="off" />
    <div class="card" id="line-list" style="max-height:55vh; overflow-y:auto">
        @foreach (var g in groups)
        {
            <div class="px-4 py-2 text-xs font-semibold text-bark" style="background:#F1F1F2" data-group>@Fam(g.Key)</div>
            @foreach (var l in g)
            {
                <label class="list-item gap-3" style="cursor:pointer" data-line="@(Fam(l.Family) + " " + l.Name + Col(l.Color))">
                    <input type="radio" name="target" value="line:@l.Id" checked="@(l.Id == preselect)" />
                    <span class="flex-1 min-w-0 text-sm">@l.Name@Col(l.Color)</span>
                    <span class="text-xs text-bark-l shrink-0">@(l.Total?.ToString("N0") ?? "—")</span>
                </label>
            }
        }
        <div class="px-4 py-2 text-xs font-semibold text-bark" style="background:#F1F1F2">صنف جديد (غير موجود بملفات المخزون)</div>
        @foreach (var f in new[] { "metro", "sh", "screws", "kent", "smirdex" })
        {
            <label class="list-item gap-3" style="cursor:pointer" data-line="جديد @Fam(f)">
                <input type="radio" name="target" value="new:@f" />
                <span class="flex-1 text-sm">➕ صنف جديد في @Fam(f)</span>
            </label>
        }
    </div>
    <button type="submit" class="btn-primary w-full">ربط</button>
</form>

@section Scripts {
<script>
(function () {
    const f = document.getElementById('line-filter');
    const norm = s => s.toLowerCase().replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/[×*]/g, 'x').replace(/\s+/g, ' ');
    const rows = [...document.querySelectorAll('[data-line]')];
    f.addEventListener('input', () => {
        const t = norm(f.value).split(' ').filter(Boolean);
        rows.forEach(r => r.hidden = !t.every(x => norm(r.dataset.line).includes(x)));
        document.querySelectorAll('[data-group]').forEach(g => {
            let n = g.nextElementSibling, any = false;
            while (n && n.hasAttribute('data-line')) { if (!n.hidden) any = true; n = n.nextElementSibling; }
            g.hidden = !any;
        });
    });
    // Keep the chosen line in view
    document.querySelector('#line-list input:checked')?.closest('label')?.scrollIntoView({ block: 'center' });
})();
</script>
}
