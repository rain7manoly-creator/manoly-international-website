@model IReadOnlyList<ManolyWarehouse.Application.ViewModels.ShelfGridCell>
@{
    // Row order matches physical top-to-bottom stacking on each side:
    //   ABC side: A, B, C
    //   DEF side: H, G, D, E, F  (H and G sit on top of the D/E/F rack)
    // Any unknown label sorts to the end alphabetically.
    static int RowOrder(string label) => label switch
    {
        "A" => 0, "B" => 1, "C" => 2,
        "H" => 3, "G" => 4, "D" => 5, "E" => 6, "F" => 7,
        _ => 100
    };
    var rows = Model.GroupBy(c => c.Label)
        .OrderBy(g => RowOrder(g.Key))
        .ThenBy(g => g.Key)
        .ToList();
}

<div class="sgrid-scroll" role="region" aria-label="خريطة الأرفف">

    @* ── One row per shelf letter ── *@
    @foreach (var row in rows)
    {
        <div class="sgrid-row">
            <div class="sgrid-row-label">@row.Key</div>
            @foreach (var cell in row.OrderBy(c => c.Number))
            {
                string bg = cell.IsEmpty  ? "sgrid-empty"
                    : cell.IsFull         ? "sgrid-full"
                    : cell.OccupiedSlots switch {
                        1 => "sgrid-p1",
                        2 => "sgrid-p2",
                        3 => "sgrid-p3",
                        4 => "sgrid-p4",
                        _ => "sgrid-p5"
                    };
                <a href="/shelves/@cell.Code"
                   class="sgrid-cell @bg"
                   title="@cell.Code · @cell.OccupiedSlots/6"
                   aria-label="رف @cell.Code">
                    <span class="sgrid-num">@cell.Number</span>
                    @if (cell.OccupiedSlots > 0)
                    {
                        <span class="sgrid-dots">
                            @for (int s = 1; s <= 6; s++)
                            {
                                <span class="sgrid-dot @(s <= cell.OccupiedSlots ? "sgrid-dot-on" : "sgrid-dot-off")"></span>
                            }
                        </span>
                    }
                </a>
            }
        </div>
    }

</div>

<style>
/* ── Scroll container ── */
.sgrid-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* Hide scrollbar on touch/mobile — users swipe naturally */
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 12px 12px;
    position: relative;
}
.sgrid-scroll::-webkit-scrollbar { display: none; }

/* Show a thin scrollbar on desktop (pointer/hover devices) */
@@media (hover: hover) {
    .sgrid-scroll {
        scrollbar-width: thin;
        scrollbar-color: #C9CACC #F1F1F2;
        padding-bottom: 16px;
    }
    .sgrid-scroll::-webkit-scrollbar         { display: block; height: 5px; }
    .sgrid-scroll::-webkit-scrollbar-track   { background: #F1F1F2; border-radius: 3px; }
    .sgrid-scroll::-webkit-scrollbar-thumb   { background: #C9CACC; border-radius: 3px; }
    .sgrid-scroll::-webkit-scrollbar-thumb:hover { background: #A7A9AC; }
}

/* ── Each row is a flex row ── */
.sgrid-row {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-bottom: 3px;
}

/* ── Sticky letter label on the right (RTL) ── */
.sgrid-row-label {
    width: 22px;
    min-width: 22px;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #58595B;
    flex-shrink: 0;
    position: sticky;
    right: 0;
    background: #FFFFFF;
    z-index: 2;
    padding: 0 2px;
}

/* ── Individual shelf cell ── */
.sgrid-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 38px;
    min-width: 38px;
    height: 42px;
    border-radius: 6px;
    text-decoration: none;
    gap: 3px;
    flex-shrink: 0;
    transition: transform 120ms, opacity 120ms;
    position: relative;
}
.sgrid-cell:active {
    transform: scale(0.92);
    opacity: 0.8;
}

/* ── Shelf number inside cell ── */
.sgrid-num {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
}

/* ── Mini 6-dot occupancy strip ── */
.sgrid-dots {
    display: flex;
    gap: 1.5px;
}
.sgrid-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
}

/* ── Status colours ── */
/* Fullness scale in Manoly brand colours: grey (empty) → red tints → dark red (full) */
/* Empty */
.sgrid-empty              { background: #EEEFF0; }
.sgrid-empty .sgrid-num   { color: #A7A9AC; }
.sgrid-empty .sgrid-dot-on  { background: #A7A9AC; }
.sgrid-empty .sgrid-dot-off { background: #D9DADC; }

/* Partial-1 (1/6) */
.sgrid-p1              { background: #FCEFEF; }
.sgrid-p1 .sgrid-num   { color: #CA292E; }
.sgrid-p1 .sgrid-dot-on  { background: #CA292E; }
.sgrid-p1 .sgrid-dot-off { background: #F2D3D4; }

/* Partial-2 (2/6) */
.sgrid-p2              { background: #F9E0E0; }
.sgrid-p2 .sgrid-num   { color: #CA292E; }
.sgrid-p2 .sgrid-dot-on  { background: #CA292E; }
.sgrid-p2 .sgrid-dot-off { background: #EEC3C4; }

/* Partial-3 (3/6) */
.sgrid-p3              { background: #F4C9CA; }
.sgrid-p3 .sgrid-num   { color: #A81F24; }
.sgrid-p3 .sgrid-dot-on  { background: #A81F24; }
.sgrid-p3 .sgrid-dot-off { background: #E6AEB0; }

/* Partial-4 (4/6) */
.sgrid-p4              { background: #ECA9AB; }
.sgrid-p4 .sgrid-num   { color: #871518; }
.sgrid-p4 .sgrid-dot-on  { background: #871518; }
.sgrid-p4 .sgrid-dot-off { background: #DD9093; }

/* Partial-5 (5/6) */
.sgrid-p5              { background: #E07F82; }
.sgrid-p5 .sgrid-num   { color: #5E0E10; }
.sgrid-p5 .sgrid-dot-on  { background: #5E0E10; }
.sgrid-p5 .sgrid-dot-off { background: #CC6B6E; }

/* Full: brand dark red */
.sgrid-full              { background: #871518; }
.sgrid-full .sgrid-num   { color: #FFFFFF; }
.sgrid-full .sgrid-dot-on  { background: #FFFFFF; }
.sgrid-full .sgrid-dot-off { background: #A8383B; }

/* ── Hover on desktop ── */
@@media (hover: hover) {
    .sgrid-cell:hover {
        transform: scale(1.12);
        z-index: 3;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
}
</style>
