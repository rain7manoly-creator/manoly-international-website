@{
    ViewData["Title"] = "إضافة خشب";
    var types = ((IReadOnlyList<string>)ViewBag.Types).Concat(new[] { "MDF", "ابلكاش (Plywood)", "حبيبي (Chipboard)", "ميلامين", "HPL", "زان", "سويد", "OSB" })
        .Distinct().ToList();
    var preType = Context.Request.Query["type"].ToString();
}

<div class="px-4 pt-5 pb-3">
    <a href="/wood" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        مستودع الخشب
    </a>
    <h1 class="page-title">إضافة خشب</h1>
</div>

<form method="post" action="/wood/add" class="mx-4 card p-5 mb-8 flex flex-col gap-4">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label class="form-label" for="name">اسم الصنف</label>
        <input type="text" id="name" name="name" maxlength="200" class="form-input" placeholder="مثلاً: م د ف 17 ملم اخضر مشلح" />
        <p class="text-xs text-bark-l mt-1">اختياري — إذا تركته فارغاً يُكتب الاسم من النوع والسماكة والمقاس.</p>
    </div>
    <div class="grid grid-cols-3 gap-2">
        <div class="form-group">
            <label class="form-label" for="code">الكود</label>
            <input type="text" id="code" name="code" maxlength="30" class="form-input" dir="ltr" placeholder="MDF100022" />
        </div>
        <div class="form-group">
            <label class="form-label" for="unit">الوحدة</label>
            <select id="unit" name="unit" class="form-select"><option>لوح</option><option>م³</option><option>قطعة</option></select>
        </div>
        <div class="form-group">
            <label class="form-label" for="perBundle">لوح بالربطة</label>
            <input type="text" id="perBundle" name="perBundle" maxlength="20" class="form-input" dir="ltr" placeholder="55" />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="type">المجموعة / النوع</label>
        <input type="text" id="type" name="type" list="wood-types" value="@preType" class="form-input" required maxlength="60" placeholder="MDF، ابلكاش، ميلامين…" autofocus="@(string.IsNullOrEmpty(preType))" />
        <datalist id="wood-types">@foreach (var t in types) { <option value="@t"></option> }</datalist>
    </div>
    <div class="grid grid-cols-3 gap-2">
        <div class="form-group">
            <label class="form-label" for="thickness">السماكة mm</label>
            <input type="number" id="thickness" name="thickness" step="0.1" min="0" class="form-input" inputmode="decimal" placeholder="18" autofocus="@(!string.IsNullOrEmpty(preType))" />
        </div>
        <div class="form-group">
            <label class="form-label" for="length">الطول cm</label>
            <input type="number" id="length" name="length" step="0.1" min="0" class="form-input" inputmode="decimal" placeholder="244" />
        </div>
        <div class="form-group">
            <label class="form-label" for="width">العرض cm</label>
            <input type="number" id="width" name="width" step="0.1" min="0" class="form-input" inputmode="decimal" placeholder="122" />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="color">اللون / التشطيب (اختياري)</label>
        <input type="text" id="color" name="color" maxlength="80" class="form-input" placeholder="أبيض، جوز، Egger H1145…" />
    </div>
    <div class="form-group">
        <label class="form-label" for="quantity">الكمية</label>
        <input type="number" id="quantity" name="quantity" min="0" step="any" value="0" class="form-input" inputmode="decimal" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="notes">ملاحظة (اختيارية)</label>
        <input type="text" id="notes" name="notes" maxlength="300" class="form-input" placeholder="المورد، وجهين، مقاوم للرطوبة…" />
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary flex-1">حفظ</button>
        <button type="submit" name="again" value="1" class="btn-secondary flex-1">حفظ وإضافة آخر</button>
    </div>
</form>
